    "FMO 助手" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FMO Companion"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FMO 助手"
          }
        }
      }
    },
    "FMO 助手仅为连接你选择的 FMO、同步位置、接入 APRS 网络以及在本机保存消息与 QSO 记录而处理必要数据。我们不提供广告，不进行跨 App 跟踪，也不出售个人数据。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FMO Companion processes only the data needed to connect to your selected FMO, sync location, access the APRS network, and store messages and QSO records on this device. We do not show ads, track you across apps, or sell personal data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FMO 助手仅为连接你选择的 FMO、同步位置、接入 APRS 网络以及在本机保存消息与 QSO 记录而处理必要数据。我们不提供广告，不进行跨 App 跟踪，也不出售个人数据。"
          }
        }
      }
    },
